configuration {
    modi: "drun,run";
    show-icons: true;
    display-drun: "Apps";
    font: "JetBrains Mono 11";
    drun-display-format: "{name}";
}

* {
    background: #1d2021;
    background-alt: #282828;
    foreground: #ebdbb2;
    muted: #928374;
    accent: #b8bb26;
}

window {
    width: 38%;
    padding: 12px;
    border: 1px;
    border-color: @background-alt;
    background-color: @background;
}

mainbox {
    spacing: 10px;
    background-color: transparent;
}

inputbar {
    padding: 8px;
    background-color: @background-alt;
    text-color: @foreground;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
    background-color: transparent;
}

element {
    padding: 7px;
    background-color: transparent;
    text-color: @foreground;
}

element selected {
    background-color: @background-alt;
    text-color: @accent;
}
