Config
  { font = "xft:JetBrains Mono:size=9"
  , additionalFonts = []
  , border = NoBorder
  , bgColor = "#1d2021"
  , fgColor = "#ebdbb2"
  , position = Top
  , lowerOnStart = True
  , pickBroadest = False
  , persistent = True
  , hideOnStart = False
  , allDesktops = True
  , overrideRedirect = True
  , sepChar = "%"
  , alignSep = "}{"
  , commands =
      [ Run XMonadLog
      , Run Com "sh" ["-c", "$HOME/.local/bin/gruvnode-xmobar-battery"] "battery" 30
      , Run Com "sh" ["-c", "$HOME/.local/bin/gruvnode-xmobar-volume"] "volume" 10
      , Run Date "%H:%M:%S" "date" 1
      ]
  , template = "}{ %date%  %battery%  %volume% "
  }
