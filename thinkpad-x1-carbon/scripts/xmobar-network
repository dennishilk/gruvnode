#!/usr/bin/env bash
set -u

if ! command -v nmcli >/dev/null 2>&1; then
  printf 'net n/a\n'
  exit 0
fi

device="$(
  nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null \
    | awk -F: '$3 == "connected" && $2 != "loopback" { print $1; exit }'
)"

if [[ -n "$device" ]]; then
  printf 'net %s\n' "$device"
else
  printf 'net offline\n'
fi
